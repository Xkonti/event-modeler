# Event Modeler backend — local dev env
# During local dev, .env is assumed identical to this file.
POSTGRESQL_CONNECTION_STRING=postgresql://event_modeler:event_modeler@localhost:5432/event_modeler
PORT=3000

# --- Auth (better-auth core) ---
# Signing/cookie/CSRF secret (better-auth default env name). 32+ chars. Dev-only.
BETTER_AUTH_SECRET=SKPiFo4yMM3A6RlO+yQCtkWsRFwx175I-dev-only
# Browser-facing (proxied) origin in dev — Vite serves :5173, forwards /api to :3000.
BETTER_AUTH_URL=http://localhost:5173
# Comma-separated list of trusted origins.
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# --- Crypto-shredding keys (base64, exactly 32 bytes decoded) ---
# KEK: master key wrapping every per-user DEK at rest. Dev-only value below.
AUTH_KEK=QyenQWHVgIG2zgOS+sOZJjVmV9CGTue4Qi1Vzkg2tww=
# HMAC key for the deterministic email blind index. Separate key from KEK by design.
EMAIL_INDEX_KEY=mFY5Npee2BI+55w4lHUCemOoKVKkiuA1d4BdTCsfYuE=
