{
  "name": "event-modeler-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Event Modeler — event-sourced backend (Emmett + Pongo + PostgreSQL)",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "migrate": "bun run src/migrations/constraints.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:integration": "node --test 'test/integration/*.test.ts'",
    "test:integration:auth": "node --test 'test/integration/auth-*.test.ts'",
    "test:all": "bun run test && bun run test:integration",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@event-driven-io/emmett": "latest",
    "@event-driven-io/emmett-expressjs": "latest",
    "@event-driven-io/emmett-postgresql": "latest",
    "@event-driven-io/pongo": "latest",
    "better-auth": "^1.6.14",
    "express": "^4.21.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.20.0",
    "typescript": "^5.6.0"
  }
}
